# Optional. Copy to .env next to docker-compose.yml. Every line has a default: if you change nothing, FlowlyStack still starts.
# The installer script writes this file for you; you can also edit it by hand.

# The port on this computer (open http://127.0.0.1:<port>)
# FLOWLYSTACK_PORT=8372

# Your time zone, so "today" in the Dashboard is your today. Examples: America/New_York, Europe/London, Asia/Bangkok
# TZ=UTC

# Linux only: your own user and group id (run `id -u` and `id -g`), so ./prompts belongs to you. Mac and Windows: leave it.
# PUID=1000
# PGID=1000

# The Dashboard: the folders where Claude Code and Codex keep their history. Leave a line out when you do not use that agent.
# Use the full path of your own home folder in place of /path/to/home (run `echo ~` to see it; on Windows use forward slashes).
# Claude Code (terminal and the Claude desktop app's Code tab) writes to ~/.claude/projects
# CLAUDE_PROJECTS_DIR=/path/to/home/.claude/projects
# Codex writes to ~/.codex/sessions (and ~/.codex/archived_sessions)
# CODEX_SESSIONS_DIR=/path/to/home/.codex/sessions
# CODEX_ARCHIVED_DIR=/path/to/home/.codex/archived_sessions
# Open WebUI (for the Ollama view): the folder that holds its webui.db. Open WebUI must keep its data in a folder on this computer; for a Docker
# named volume see the comment at the bottom of docker-compose.yml.
# OPENWEBUI_DATA_DIR=/path/to/openwebui-data
# Your own 5-hour token cap for the usage gauge (a number). Without it, 100% means your own busiest window. See docs/usage-limits.md
# FLOWLYSTACK_SESSION_TOKENS=1500000
# Which agents the Dashboard offers (comma list). Open WebUI (Ollama) is added by itself as soon as its folder is set above.
# FLOWLYSTACK_SOURCES=claude,codex

# Only when a reverse proxy (Caddy, Nginx) is the only way to reach the app: believe its X-Forwarded-* headers. Leave it out otherwise.
# FLOWLYSTACK_TRUST_PROXY=1
